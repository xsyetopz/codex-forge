{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$PLUGIN_ROOT/scripts/hook.py\" SessionStart",
						"timeout": 10
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$PLUGIN_ROOT/scripts/hook.py\" PreToolUse",
						"timeout": 10
					}
				]
			}
		],
		"SubagentStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$PLUGIN_ROOT/scripts/hook.py\" SubagentStart",
						"timeout": 10
					}
				]
			}
		]
	}
}
