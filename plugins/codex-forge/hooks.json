{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$PLUGIN_ROOT/scripts/hook.py\" SessionStart",
						"timeout": 10,
						"statusMessage": "[cf] session policy"
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$PLUGIN_ROOT/scripts/hook.py\" UserPromptSubmit",
						"timeout": 30,
						"statusMessage": "[cf] task routing"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$PLUGIN_ROOT/scripts/hook.py\" PreToolUse",
						"timeout": 10,
						"statusMessage": "[cf] policy check"
					}
				]
			}
		],
		"SubagentStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$PLUGIN_ROOT/scripts/hook.py\" SubagentStart",
						"timeout": 10,
						"statusMessage": "[cf] child policy"
					}
				]
			}
		]
	}
}
