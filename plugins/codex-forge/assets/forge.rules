# Codex Forge hard-deny rules. Strictest matching rule wins.
# These remain forbidden even when approval_policy=never.

prefix_rule(pattern=["rm"], decision="forbidden", justification="[cf] File deletion is disabled. Use a reversible edit or let the user delete explicitly.")
prefix_rule(pattern=["rmdir"], decision="forbidden", justification="[cf] Directory deletion is disabled.")
prefix_rule(pattern=["unlink"], decision="forbidden", justification="[cf] File deletion is disabled.")
prefix_rule(pattern=["shred"], decision="forbidden", justification="[cf] Destructive overwrite is disabled.")
prefix_rule(pattern=["truncate"], decision="forbidden", justification="[cf] Destructive truncation is disabled.")
prefix_rule(pattern=[["dd","mkfs","mkfs.ext4","mkfs.xfs","wipefs","fdisk","parted"]], decision="forbidden", justification="[cf] Block-device destructive commands are disabled.")
prefix_rule(pattern=[["shutdown","reboot","halt","poweroff"]], decision="forbidden", justification="[cf] Host power-state changes are disabled.")
prefix_rule(pattern=[["sudo","doas"]], decision="forbidden", justification="[cf] Privilege escalation is disabled.")

prefix_rule(pattern=["git","clean"], decision="forbidden", justification="[cf] Destructive working-tree cleanup is disabled.")
prefix_rule(pattern=["git","reset","--hard"], decision="forbidden", justification="[cf] Destructive reset is disabled.")
prefix_rule(pattern=["git","checkout","--"], decision="forbidden", justification="[cf] Bulk destructive checkout is disabled; use focused patches.")
prefix_rule(pattern=["git","restore","."], decision="forbidden", justification="[cf] Bulk destructive restore is disabled.")
prefix_rule(pattern=["git","branch","-D"], decision="forbidden", justification="[cf] Forced branch deletion is disabled.")
prefix_rule(pattern=["git","stash",["drop","clear"]], decision="forbidden", justification="[cf] Stash destruction is disabled.")
prefix_rule(pattern=["git","rebase"], decision="forbidden", justification="[cf] History rewriting is disabled.")
prefix_rule(pattern=["git","filter-branch"], decision="forbidden", justification="[cf] History rewriting is disabled.")
prefix_rule(pattern=["git","filter-repo"], decision="forbidden", justification="[cf] History rewriting is disabled.")
prefix_rule(pattern=["git","reflog","expire"], decision="forbidden", justification="[cf] Reflog destruction is disabled.")
prefix_rule(pattern=["git","commit","--amend"], decision="forbidden", justification="[cf] History rewriting is disabled.")
prefix_rule(pattern=["git","push"], decision="forbidden", justification="[cf] Remote Git writes are disabled by Forge. The user must perform or explicitly reconfigure external writes.")

prefix_rule(pattern=["gh","pr",["create","comment","review","merge","close","reopen"]], decision="forbidden", justification="[cf] GitHub PR mutation/messaging is disabled.")
prefix_rule(pattern=["gh","issue",["create","comment","close","reopen","edit"]], decision="forbidden", justification="[cf] GitHub issue mutation/messaging is disabled.")
prefix_rule(pattern=["gh","release",["create","delete","edit","upload"]], decision="forbidden", justification="[cf] GitHub release mutation is disabled.")
prefix_rule(pattern=["npm","publish"], decision="forbidden", justification="[cf] Publication is disabled.")
prefix_rule(pattern=["pnpm","publish"], decision="forbidden", justification="[cf] Publication is disabled.")
prefix_rule(pattern=["yarn","npm","publish"], decision="forbidden", justification="[cf] Publication is disabled.")
prefix_rule(pattern=["twine","upload"], decision="forbidden", justification="[cf] Publication is disabled.")
prefix_rule(pattern=["cargo","publish"], decision="forbidden", justification="[cf] Publication is disabled.")
prefix_rule(pattern=["docker","push"], decision="forbidden", justification="[cf] Registry publication is disabled.")
prefix_rule(pattern=["helm",["install","upgrade","uninstall"]], decision="forbidden", justification="[cf] Cluster mutation is disabled.")
prefix_rule(pattern=["kubectl",["apply","create","delete","edit","patch","replace","rollout","scale","set","taint","drain","cordon","uncordon"]], decision="forbidden", justification="[cf] Cluster mutation is disabled.")
prefix_rule(pattern=["terraform",["apply","destroy","import"]], decision="forbidden", justification="[cf] Infrastructure mutation is disabled.")
prefix_rule(pattern=["tofu",["apply","destroy","import"]], decision="forbidden", justification="[cf] Infrastructure mutation is disabled.")
prefix_rule(pattern=[["ssh","scp","sftp"]], decision="forbidden", justification="[cf] Remote-host mutation/command execution is disabled.")
prefix_rule(pattern=["rsync"], decision="forbidden", justification="[cf] Remote/local destructive synchronization is disabled by default.")
