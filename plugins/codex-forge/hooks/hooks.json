{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$PLUGIN_ROOT/scripts/hooks/session-start/provide-code-discovery-context.mjs\" SessionStart",
						"timeout": 10
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$PLUGIN_ROOT/scripts/hooks/pre-tool-use/block-dangerous-shell-commands.mjs\" PreToolUse",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "bun \"$PLUGIN_ROOT/scripts/hooks/pre-tool-use/enforce-agent-spawn-boundaries.mjs\" PreToolUse",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "bun \"$PLUGIN_ROOT/scripts/hooks/pre-tool-use/advise-efficient-tool-use.mjs\" PreToolUse",
						"timeout": 10
					}
				]
			}
		],
		"SubagentStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$PLUGIN_ROOT/scripts/hooks/subagent-start/provide-worker-boundary-context.mjs\" SubagentStart",
						"timeout": 10
					}
				]
			}
		]
	}
}
