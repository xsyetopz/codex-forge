{
	"description": "Codex Forge continuity context and focused safety guardrails.",
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$PLUGIN_ROOT/scripts/hooks/session-start/restore-continuity.mjs\"",
						"timeout": 10,
						"additionalContextLimit": 4096
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "^Agent$",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$PLUGIN_ROOT/scripts/hooks/pre-tool-use/enforce-agent-spawn-boundaries.mjs\"",
						"timeout": 10
					}
				]
			},
			{
				"matcher": "^multi_agent_v1(?:__|[._:-])?spawn_agent$",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$PLUGIN_ROOT/scripts/hooks/pre-tool-use/enforce-agent-spawn-boundaries.mjs\"",
						"timeout": 10
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$PLUGIN_ROOT/scripts/hooks/user-prompt-submit/preserve-raw.mjs\"",
						"timeout": 10,
						"additionalContextLimit": 128
					}
				]
			}
		],
		"SubagentStart": [
			{
				"matcher": "^forge-",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$PLUGIN_ROOT/scripts/hooks/subagent-start/provide-boundary-context.mjs\"",
						"timeout": 10,
						"additionalContextLimit": 100
					}
				]
			}
		],
		"SubagentStop": [
			{
				"matcher": "^forge-",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$PLUGIN_ROOT/scripts/hooks/subagent-stop/record-handoff.mjs\"",
						"timeout": 10
					}
				]
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$PLUGIN_ROOT/scripts/hooks/session-end/clear-continuity.mjs\"",
						"timeout": 3
					}
				]
			}
		]
	}
}
