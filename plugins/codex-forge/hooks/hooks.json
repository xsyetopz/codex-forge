{
	"description": "Codex Forge continuity context and focused agent-control guardrails.",
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$PLUGIN_ROOT/scripts/hooks/session-start/restore-continuity.mjs\"",
						"timeout": 10,
						"additionalContextLimit": 4096
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "^Agent$",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$PLUGIN_ROOT/scripts/hooks/pre-tool-use/enforce-agent-control-boundaries.mjs\"",
						"timeout": 10
					}
				]
			},
			{
				"matcher": "^multi_agent_v1(?:__|[._:-])?spawn_agent$",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$PLUGIN_ROOT/scripts/hooks/pre-tool-use/enforce-agent-control-boundaries.mjs\"",
						"timeout": 10
					}
				]
			},
			{
				"matcher": "^(?:create_goal|update_goal)$",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$PLUGIN_ROOT/scripts/hooks/pre-tool-use/enforce-agent-control-boundaries.mjs\"",
						"timeout": 10
					}
				]
			}
		],
		"SubagentStart": [
			{
				"matcher": "^forge-",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$PLUGIN_ROOT/scripts/hooks/subagent-start/record-agent-start.mjs\"",
						"timeout": 10
					}
				]
			}
		],
		"SubagentStop": [
			{
				"matcher": "^forge-",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$PLUGIN_ROOT/scripts/hooks/subagent-stop/record-handoff.mjs\"",
						"timeout": 10
					}
				]
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$PLUGIN_ROOT/scripts/hooks/session-end/clear-continuity.mjs\"",
						"timeout": 3
					}
				]
			}
		]
	}
}
